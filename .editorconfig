# What an editor should do with the files in this repository, whatever editor
# that is -- VS Code, PyCharm, Vim, Emacs, Sublime and the rest read this file.
# The mirror of pyguitest's own, so the two halves of this project cannot
# disagree about a file's shape when one is edited after the other.
#
# Line endings are the half of this that matters. The recorder is developed on
# Linux and GhostBSD and reaches a Windows box for its live checks (see
# docs/developers/status.md), and a file saved there with CRLF comes back as a
# whole-file diff to everyone else. Git cannot see an editor's settings, so
# this file is paired with `.gitattributes`, which is what makes git normalize
# what it stores; this is what an editor is told before it writes.
#
# Measured rather than assumed, when this was written: all 60 tracked files end
# their lines with LF, no tracked file contains a tab, and every indent size
# below is the one that file type already uses -- Python, shell and TOML at 4,
# YAML at 2. Nothing here is a file type only Windows reads (no .bat, .cmd or
# .ps1), so nothing needs CRLF in the working tree.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown. Nothing here ends a
# line with a pair today (measured), so this changes nothing now -- it is here
# so that an editor or a hook cannot silently join a line someone meant to
# break later, which is the same setting pyguitest carries for the same reason.
trim_trailing_whitespace = false
